# Line endings.
#
# Text is stored as LF in the repository and checked out as LF on every
# platform, so a Windows checkout does not produce CRLF-only diffs.
# Windows command scripts are the only exception: cmd.exe needs CRLF.
* text=auto eol=lf

*.go text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.js text eol=lf
*.mjs text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never diff, never convert.
*.png binary
*.jpg binary
